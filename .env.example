# Centralizegg Environment Variables Template
# Copy this file to '.env' and adjust values for your local environment.

# Database Configuration
DB_HOST=centralizegg__trn_db
DB_PORT=5432
DB_USER=centralizegg
DB_PASS=centralizegg_secret
DB_NAME=centralizegg_db

# Infrastructure Configuration
LIBVIRT_SOCK=/var/run/libvirt/libvirt-sock
